// [Info] The order of "ports_dict" is same as the order of pin-list in the spice file. 
{
   "process_name"       :"OSU035"
  ,"lib_vendor_id"      :"VENDOR"
  ,"revision"           :"REV2"
  ,"model_path"         :"./sample_target/OSU035"
//--- ISS-00184: model file の .lib section 名（既定）。 charao は
//    .lib '<model file>' <section> で読む。 セル個別に変えたい場合は
//    cell_info 側の "model_section" が優先される（例 decap: ["mos","rc"]）。
  ,"model_section"      : ["mos"]
//,"cell_spice_path"    :"./sample_src/OSU035/std/NORMAL/V00.00/spice"
//,"io_spice_path"      :"./sample_src/OSU035/io/NORMAL/V00.00/spice"
  ,"result_path"        :"./rslt"
  ,"vdd_name"           :"VDD"
  ,"vss_name"           :"VSS"
  ,"pwell_name"         :"VPW"
  ,"nwell_name"         :"VNW"
  ,"voltage_unit"       :"V"
  ,"capacitance_unit"   :"pf"
  ,"resistance_unit"    :"Ohm"
  ,"current_unit"       :"mA"
  ,"leakage_power_unit" :"pW"
  ,"energy_unit"        :"fJ"
  ,"time_unit"          :"ns"

//--- characterization conditions
// "cell_group"                  : "std"     //--- set by argv of libretto.py
// "process_corner"              : "TC"      //--- set by argv of libretto.py
//,"temperature"                 : 25.0      //--- set by argv of libretto.py
//,"vdd_voltage"                 : 5.0       //--- set by argv of libretto.py
//,"vss_voltage"                 : 0.0       //--- set by argv of libretto.py
//,"pwell_voltage"               : 0.0       //--- set by argv of libretto.py
//,"nwell_voltage"               : 5.0       //--- set by argv of libretto.py
  ,"logic_threshold_high"        : 0.8
  ,"logic_threshold_low"         : 0.2
  ,"logic_high_to_low_threshold" : 0.5
  ,"logic_low_to_high_threshold" : 0.5
// ISS-00218(A): const 判定量 judge_dly の TRIG 側閾値（入力信号＝制約ピン / CLK 側）。
//   遷移の「開始側」に置く（rise=0.1 / fall=0.9）。 TARG（出力）は 50% のまま。
//   .lib に出る値・ヘッダ宣言（input/output_threshold_pct 等）には一切影響しない。
//   50% 基準だと nominal に「入力が 50% から実効的な確定点まで進む時間」が混入し、
//   slew が緩いほど判定量が小さく評価されて、 絶対値の sim_time_const_threshold が
//   corner ごとに違う厳しさになってしまう。
  ,"const_judge_threshold_rise"  : 0.1
  ,"const_judge_threshold_fall"  : 0.9
  ,"energy_meas_low_threshold"   : 0.01
  ,"energy_meas_high_threshold"  : 0.99
  ,"hold_meas_high_threshold"    : 0.01
  ,"hold_meas_low_threshold"     : 0.99 
//--- templates（2026-07-29 全面刷新。 V02.00 セル用）
//    index_1 = 入力 slew [ns]  : 0.05〜8.0 ns（0.35um / 3.3V）を physical curve で 7 点
//    index_2 = 出力 load [pF]  : floor 0.001 ＋ Cin(0.0045) x fanout{1,3,8,16,32,48}
//    const は両軸とも slew（constrained_pin_transition x related_pin_transition）
//    mpw は slew 3 点（ISS-00160 で timing() constraint テーブル化）
//    OSU035 に三相態セルは無いため delay_disable は定義しない
  ,"templates"                   :[
    {"kind":"leakage"   ,"grid":"0x0","name":"d000","index_1":[], "index_2":[]}
       ,{"kind":"passive"   ,"grid":"7x0","name":"d000","index_1":[0.05,0.138,0.344,0.815,1.93,4.14,8], "index_2":[]}
       ,{"kind":"mpw"       ,"grid":"3x0","name":"d000","index_1":[0.05,0.815,8], "index_2":[]}
       ,{"kind":"const"     ,"grid":"7x7","name":"d000","index_1":[0.05,0.138,0.344,0.815,1.93,4.14,8],"index_2":[0.05,0.138,0.344,0.815,1.93,4.14,8]}

    //---- delay: 1 group (generated from new: single Cin)
       ,{"kind":"delay"     ,"grid":"7x7","name":"d000","index_1":[0.05,0.138,0.344,0.815,1.93,4.14,8],"index_2":[0.001,0.0045,0.0135,0.036,0.072,0.144,0.216]}

    //---- power_tout: 出力ピンの internal_power（delay と同じ軸）
       ,{"kind":"power_tout","grid":"7x7","name":"d000","index_1":[0.05,0.138,0.344,0.815,1.93,4.14,8],"index_2":[0.001,0.0045,0.0135,0.036,0.072,0.144,0.216]}

    //---- power_tin: 入力ピンの internal_power（load 非依存＝slew のみ）
       ,{"kind":"power_tin" ,"grid":"7x0","name":"d000","index_1":[0.05,0.138,0.344,0.815,1.93,4.14,8], "index_2":[]}
      ]
  
//characterizer settings
//,"work_dir"  :"work"      //--- set by argv of libretto.py
//,"tmp_dir"   :"work"
//,"tmp_file"  :"_tmp__"
  ,"simulator" :"ngspice"
//,"simulator" :/"usr/local/bin/ngspice"
//,"simulator" :"/eda/synopsys/hspice/T-2022.06/hspice/linux64/hspice"
  ,"runsim"     :"true"
//--- num_thread : ISS-00079 の sweet spot（8 以上は ngspice 内部の直列ボトルネックで逆に遅い）
  ,"num_thread" : 4
//--- ISS-00230: 有効桁。 .lib / doc の出力桁に加え、 maxstep(=.tran の tmax) の有効桁にも使う。
//    ⚠ この値を変えると sim の刻みも変わる＝結果が動く。 未指定ならモデル既定 3。
  ,"significant_digits" : 3
  ,"sim_nice"   : 19

//--- 2026-07-29 追加（a29〜a33 で導入されたキー。 未指定でも既定値で動くが明示する）
//    slew_derate: OSU035 に orig .lib が無いため derate なし（1.0）。 .lib 格納値＝実測値
  ,"slew_derate_from_library"    : 1.0
//    leakage_offset: 全セル一律加算（orig .lib が無く校正できないため 0.0）
  ,"leakage_offset"              : 0.0
//    leakage_stable_time: leakage の DC op 前段 tran の静定時間 [ns]（ISS-00166）
  ,"leakage_stable_time"         : 1.0
//    simulation_slew_min: min_pulse/setup/hold の PWL slew 下限 [ns]
// ISS-00219: const / delay / mpw で出力遷移 trans_out に何点のサンプルを乗せるか（点数）。
//   maxstep = min(maxstep, trans_out / この値)。 掃引位置を固定したまま反復収束させる。
//   0.0 で無効＝従来動作。 2.0 は実測（sky130 dfxtp_1 setup 最悪点で差 5.0064 → 0.0474 ns）。
  ,"simulation_points_per_transition" : 2.0
  ,"simulation_slew_min"         : 0.001
  ,"tmax_high"              : 20
// ISS-00219/00223: 出力遷移 trans_out に対し 4 点以上を目安に決める（trans_out / tmax_low）。
//   sky130 は遷移 17〜25ps で 0.02 だと約 1 点＝不足のため 0.002。gf180 は 70〜96ps で 0.02（約 4 点）で十分。
  ,"tmax_low"               : 0.02
  ,"sim_pulse_max"              : 3.0
  ,"sim_prop_max"               : 20.0
  ,"sim_prop_tri_max"           : 20.0
  ,"sim_prop_io_max"            : 25.0
  ,"sim_prop_io_tri_max"        : 25.0
  ,"sim_d2c_max"                : 5.0
	,"sim_c2d_min"                : 10.0
	,"sim_c2d_max"                : 200.0
  ,"sim_c2d_max_per_unit"       : 40.0
  ,"sim_segment_timestep_start" : 1.0
  ,"sim_segment_timestep_ratio" : 0.1
  ,"sim_segment_timestep_min"   : 0.001
  ,"sim_time_const_threshold"   : 0.01
// ISS-00218(B): const 掃引の終了判定に使う劣化量の閾値を、基準遅延 d0 に比例させる係数。
//   閾値 = min(sim_time_const_threshold, d0 × 本係数)。 d0 は judge_dly の running-min。
//   0.0（既定・未指定）で比例項を無効＝従来どおり sim_time_const_threshold の絶対値のみ。
  ,"sim_time_const_threshold_ratio" : 0.03
// ISS-00218(B): min_pulse_width 掃引の劣化判定に使う閾値 [ns]。
//   const（setup/hold/recovery）とは判定量が違うため別キーにした。
//   値は従来 const と共用していたときと同じ（挙動不変）。
  ,"sim_time_pulse_threshold"       : 0.01
// ISS-00220: const 掃引の高速化。 0 回目（準備 run）で _t_init3 時点の内部ノード電圧を取得し、
//   1 回目以降は nodeset で復元して測定区間だけ回す（初期化のやり直しを止める）。
//   false で従来動作（0 から回し直す）。 値の切り分け用に残してある。
  ,"const_start_offset_enable"       : true
  ,"sim_tsim_end4hold"          : 30.0
//  ,"sim_time_end_extent"        : 3
  
  ,"compress_result" :"False"
//,"supress_msg"     :"true"
//,"supress_sim_message:"true"
//,"supress_debug_message:"true"
  ,"supress_msg"         :"false"
  ,"supress_sim_msg"     :"false"
  ,"supress_debug_msg"    :"true"

}

