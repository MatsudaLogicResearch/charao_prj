//--- characterizer settings
  ,"simulator" :"ngspice"
//--- sky130 のセル netlist は .option scale=1.0u 前提（all.spice 側で設定される）
  ,"spiceinit" : ["set ngbehavior=hs"]
  ,"runsim"     :"true"
//--- ISS-00079 の sweet spot
  ,"num_thread" : 4
//--- ISS-00230: 有効桁。 .lib / doc の出力桁に加え、 maxstep(=.tran の tmax) の有効桁にも使う。
//    ⚠ この値を変えると sim の刻みも変わる＝結果が動く。 未指定ならモデル既定 3。
  ,"significant_digits" : 3
  ,"sim_nice"   : 19
//--- ISS-00234(2026-08-17、 ダーマツ判断): tmax_high を 20 ns -> 0.3 ns(300 ps) へ。
//    20 ns は事実上「上限なし」で slope/2 の生値がそのまま通っていた（index=1.5 で 750 ps）。
//    sky130 の出力遷移は 17〜25 ps なので 300 ps でも遷移あたり 12 点以上は確保できる。
//    ⚠ 全 measure（delay / power_* / const / min_pulse_width）に効く。
//    これにより maxstep の 7 点は 10 / 12 / 27 / 61 / 141 / 300 / 300 ps となり
//    **すべて整数 ps**（＝PWL 折れ点と同じ 1 ps 格子）になる。
//    ⚠ tmax_low / tmax_high は _fix_maxstep の ③ clamp で使うため、
//      **必ず ps 格子上の値**にすること（格子から外すと ① の効果が壊れる）。
//--- ISS-00234(2026-08-18、 ダーマツ判断): 0.3 -> 0.25 ns(250 ps)。
//    0.3 ns では `dfrtp_4` / `hold_rising` / `fall_constraint` / index_2=0.651（maxstep 300 ps）
//    の 1 列 7 点が secant 第 1 段(`s100`)で必ず落ちた（`run_sky7_full`、2026-08-17）。
//    ⚠ index_2=1.5 も 300 ps だったが無傷、`rise_constraint` も同 maxstep で無傷なので
//      「300 ps が悪い」とは言い切れない。 250 ps で変化するか確認するための試行。
//    ⚠ 影響範囲は 79,626 sim / 701,405（11.4%）＝13 measure すべてに及ぶ。
//--- ISS-00234(2026-08-21、 ダーマツ判断): 0.25 -> 20 ns へ戻す（Run ③ の切り分け）。
//    simulation_slew_min を 10 ps にした状態で、 tmax_high を a21 以前の値へ戻したときに
//    失敗が出るかを見る。 ⚠ maxstep が slope/2 の生値（最大 750 ps）まで開く。
//    ⚠ leak の AVG 窓は幅 100 ps 固定なので、 maxstep が 750 ps まで開く measure では
//      窓にサンプルが 0 点しか入らず ISS-00236 の「無警告で 0 A」が再発しうる。
//      const 系には leak の .MEASURE が出ないため本 run では発現しないが、
//      leakage / power_tin / passive を回す段階で必ず確認すること。
//--- ISS-00234(2026-08-21、 ダーマツ判断): 20 -> 0.3 ns(300 ps)。 3 PDK を同じ値に揃えて
//    slew_min 10 ps 化の退行確認を行う。 ⚠ probe(ISS-00219) が trans_out から maxstep を
//    決めるため、 この上限には届かない点が多い（Run ③ で実測 10〜17 ps）。
  ,"tmax_high"                 : 0.3
// ISS-00219/00223: 出力遷移 trans_out に対する点数を目安に決める（trans_out / tmax_low）。
//   ⚠ ISS-00230(2026-08-14): この「点数」は下限見積りであって実点数ではない。 tmax は刻みではなく
//     刻みの「上限」で、 実際の刻みは ngspice の LTE 制御が決める（docs/SPEC_measure.md §12.1）。
//     最終判断は orig との transition 誤差で行うこと。
//   sky130 は遷移 17〜25ps で 0.02 だと不足のため 0.002 としていたが、 ISS-00229(2026-08-14) で
//   0.004 へ変更。 0.002 では delmin=1e-11*tmax=2e-23 が小さすぎ、 sdlclkp_1 の setup_rising が
//   `Timestep too small ... vclk#branch` で落ちて .lib に 0 値 4 点が出ていた。
//   gf180 は 70〜96ps で 0.02 で十分（0.002 にすると orig から +58% 遠ざかる＝細かい≠高精度）。
//--- 変遷: 0.002 -> 0.004(ISS-00229) -> 0.005 -> 0.01(ISS-00234、 2026-08-15 確定)
//    ⚠ tmax_low を上げるだけでは 3 failures で頭打ちになり、 そこから
//      「maxstep が下限を守っていない経路がある」という発見に至った（ISS-00234）。
//      現在は maxstep = clamp(slope/simulation_points_per_transition, tmax_low, tmax_high)
//      に統一し、 全 measure で下限・上限を守る（docs/SPEC_measure.md §12.1.2）。
//    フロアは ISS-00087（ngspice LTE 暴走の抑制）由来。 下げすぎると delmin(=1e-11*tmax) が
//    小さくなりすぎて `Timestep too small` で落ちる（ISS-00229 / ISS-00234 で実証）。
  ,"tmax_low"                  : 0.01
//--- ISS-00234(2026-08-15): tmax_low_power_tin（power_tin 専用フロア）は廃止した。
//    ISS-00188 で「共通値を下げると power_tin の最速 slew が落ちる」として設けたが、
//    同じ関数の中で maxstep/5 して 1/5 に潰しており自己矛盾していた。 現在は tmax_low に統一。
  ,"sim_pulse_max"              : 3.0
  ,"sim_prop_max"               : 10.0
  ,"sim_prop_tri_max"           : 10.0
  ,"sim_prop_io_max"            : 15.0
  ,"sim_prop_io_tri_max"        : 15.0
  ,"sim_d2c_max"                : 3.0
  ,"sim_c2d_min"                : 5.0
  ,"sim_c2d_max"                : 100.0
  ,"sim_c2d_max_per_unit"       : 20.0
  ,"sim_segment_timestep_start" : 1.0
  ,"sim_segment_timestep_ratio" : 0.1
  ,"sim_segment_timestep_min"   : 0.001
  ,"sim_time_const_threshold"   : 0.05
// ISS-00218(B): const 掃引の終了判定に使う劣化量の閾値を、基準遅延 d0 に比例させる係数。
//   閾値 = min(sim_time_const_threshold, d0 × 本係数)。 d0 は judge_dly の running-min。
//   0.0（既定・未指定）で比例項を無効＝従来どおり sim_time_const_threshold の絶対値のみ。
  ,"sim_time_const_threshold_ratio" : 0.03
// ISS-00218(B): min_pulse_width 掃引の劣化判定に使う閾値 [ns]。
//   const（setup/hold/recovery）とは判定量が違うため別キーにした。
//   値は従来 const と共用していたときと同じ（挙動不変）。
  ,"sim_time_pulse_threshold"       : 0.05
// ISS-00220: const 掃引の高速化。 0 回目（準備 run）で _t_init3 時点の内部ノード電圧を取得し、
//   1 回目以降は nodeset で復元して測定区間だけ回す（初期化のやり直しを止める）。
//   false で従来動作（0 から回し直す）。 値の切り分け用に残してある。
  ,"const_start_offset_enable"       : true
  ,"sim_tsim_end4hold"          : 20.0

  ,"compress_result" :"False"
  ,"supress_msg"         :"false"
  ,"supress_sim_msg"     :"false"
  ,"supress_debug_msg"    :"true"
}
