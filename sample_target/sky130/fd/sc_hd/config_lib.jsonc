// SkyWater SKY130 / sky130_fd_sc_hd（high density、 1.8V core）
//   2026-07-30 新規（ISS-00181 Step 1）
//   数値は orig .lib（sky130_fd_sc_hd__tt_025C_1v80.lib）から抽出し、 有効 3 桁に丸めた値
//
// [Info] The order of "ports_dict" is same as the order of pin-list in the spice file.
{
   "process_name"       : "sky130"
  ,"lib_vendor_id"      : "fd"
  ,"revision"           : "sc_hd"
  ,"model_path"         : "./sample_target/sky130"
//--- ISS-00184: model file の .lib section 名（既定）。 charao は
//    .lib '<model file>' <section> で読む。 セル個別に変えたい場合は
//    cell_info 側の "model_section" が優先される（例 decap: ["mos","rc"]）。
  ,"model_section"      : ["mos"]
  ,"result_path"        : "./rslt"

//--- 電源端子（sky130 は VPWR/VGND ＋ バルク VPB/VNB の 4 本）
//    inv_1 の実接続： nMOS bulk = VNB ／ pMOS bulk = VPB
  ,"vdd_name"           : "VPWR"
  ,"vss_name"           : "VGND"
  ,"nwell_name"         : "VPB"
  ,"pwell_name"         : "VNB"

  ,"voltage_unit"       : "V"
  ,"capacitance_unit"   : "pf"
  ,"resistance_unit"    : "Ohm"
  ,"current_unit"       : "mA"
//--- orig .lib は leakage_power_unit : "1nW"
  ,"leakage_power_unit" : "nW"
  ,"energy_unit"        : "pJ"
  ,"time_unit"          : "ns"

//--- characterization conditions（-p / -t / --vdd は argv で与える）
//    orig: nom_voltage 1.8 / nom_temperature 25
//--- 閾値は orig .lib の実値
//    input/output_threshold_pct : 50
//    slew_lower/upper_threshold_pct : 20 / 80
  ,"logic_threshold_high"        : 0.8
  ,"logic_threshold_low"         : 0.2
  ,"logic_high_to_low_threshold" : 0.5
  ,"logic_low_to_high_threshold" : 0.5
// ISS-00218(A): const 判定量 judge_dly の TRIG 側閾値（入力信号＝制約ピン / CLK 側）。
//   遷移の「開始側」に置く（rise=0.1 / fall=0.9）。 TARG（出力）は 50% のまま。
//   .lib に出る値・ヘッダ宣言（input/output_threshold_pct 等）には一切影響しない。
//   50% 基準だと nominal に「入力が 50% から実効的な確定点まで進む時間」が混入し、
//   slew が緩いほど判定量が小さく評価されて、 絶対値の sim_time_const_threshold が
//   corner ごとに違う厳しさになってしまう。
  ,"const_judge_threshold_rise"  : 0.1
  ,"const_judge_threshold_fall"  : 0.9
  ,"energy_meas_low_threshold"   : 0.01
  ,"energy_meas_high_threshold"  : 0.99
  ,"hold_meas_high_threshold"    : 0.01
  ,"hold_meas_low_threshold"     : 0.99

//--- orig .lib の slew_derate_from_library : 1.0（derate なし＝格納値＝実測値）
  ,"slew_derate_from_library"    : 1.0
//--- leakage の一律加算（orig 比較で校正するまで 0.0）
  ,"leakage_offset"              : 0.0
//--- leakage の DC op 前段 tran の静定時間 [ns]（ISS-00166）
  ,"leakage_stable_time"         : 1.0
// ISS-00219: const / delay / mpw で出力遷移 trans_out に何点のサンプルを乗せるか（点数）。
//   maxstep = min(maxstep, trans_out / この値)。 掃引位置を固定したまま反復収束させる。
//   0.0 で無効＝従来動作。 2.0 は実測（sky130 dfxtp_1 setup 最悪点で差 5.0064 → 0.0474 ns）。
  ,"simulation_points_per_transition" : 2.0
//--- ISS-00234(2026-08-21、 ダーマツ判断): simulation_slew_min を 0.001 -> 0.01 ns(10 ps) へ。
//    PWL の遷移幅の下限。 1 ps のエッジは ngspice の LTE が刻みを詰める要因になりうるため
//    10 ps へ引き上げる。 3 PDK すべて同じ値に揃える（係数の書き換えが PDK 非依存のため、
//    片方だけ変えると leak の AVG 窓 [11*..1*] や tslew_clk が 1/10 に潰れる）。
//    ⚠ この値が効く先（実効値は括弧内）:
//      init パルスのエッジ  INIT_EDGE_MULT(2) * slew_min      (20 ps)
//      t_rel3 / t_clk7 の終端エッジ、 VPC_CTRL の両エッジ        (10 ps)
//      tslew_in / tslew_clk / tslew_rel の既定                  (10 ps)
//      未使用 phase の折れ点間隔（ISS-00134）                    (10 ps)
//      leak の AVG 窓 {_t_in0-11*slew_min .. _t_in0-1*slew_min} (幅 100 ps、 従来と同じ)
//      .MEASURE の TD マージン 1*slew_min                       (10 ps)
  ,"simulation_slew_min"         : 0.01
//--- ISS-00234(2026-08-22、 ダーマツ判断): pre-charge SW（ISS-00076）のゲートランプ幅[ns]。
//    simulation_slew_min から切り離した専用値（既定 1 ps）。
//    A4 は DUT の入力波形ではなく **アナログ SW のゲート制御**で、 SW_PRECHARGE は
//    Ron=0.1Ω → Roff=1GΩ の 10 桁をヒステリシス(Vh=0.3)付きで通過する。
//    slew_min を 1 ps -> 10 ps にしたところ、 このランプの途中で LTE が破綻し
//    sky130 dfrtp_1 に 16 件の `Timestep too small` が出た（run_tm03_sky、 t=3.00667 ns）。
  ,"sw_ramp_time"               : 0.001

//--- templates（2026-07-30、 orig .lib の index を有効 3 桁に丸めて採用）
//    丸めによるズレは 0.5% 以下で、 遅延は slew/load の滑らかな関数なので影響しない
//    （2026-07-31 ダーマツ判断。 orig 比較は NLDM 補間で index を揃えるため問題ない）
//    index_1 = 入力 slew [ns] : 0.01 〜 1.5（del_1_7_7 の実値）
//    index_2 = 出力 load [pF] : 0.0005 〜 0.181（同上）
//    const は両軸とも slew（constrained_pin_transition x related_pin_transition）
//    mpw は slew 3 点（ISS-00160）。 orig の constraint_3_0_1 が 3 点なのと整合
  ,"templates"                   :[
    //---- index_1 は delay / power_tout のみセル別になりうる（ISS-00191 の --scan_spec）。
    //     他の kind はライブラリ共通。 index_2 は delay / power_tout のみセル別（ISS-00189）
    {"kind":"leakage"   ,"grid":"0x0","name":"d000","index_1":[], "index_2":[]}
    ,{"kind":"passive"   ,"grid":"7x0","name":"d000","index_1":[0.01,0.0231,0.0531,0.122,0.282,0.651,1.5], "index_2":[]}
    ,{"kind":"mpw"       ,"grid":"3x0","name":"d000","index_1":[0.01,0.122,1.5], "index_2":[]}
    ,{"kind":"const"     ,"grid":"7x7","name":"d000","index_1":[0.01,0.0231,0.0531,0.122,0.282,0.651,1.5],"index_2":[0.01,0.0231,0.0531,0.122,0.282,0.651,1.5]}
    ,{"kind":"power_tin" ,"grid":"7x0","name":"d000","index_1":[0.01,0.0231,0.0531,0.122,0.282,0.651,1.5], "index_2":[]}

    //---- delay : 24 groups
    ,{"kind":"delay"     ,"grid":"7x7","name":"d0p0368","index_1":[0.01,0.0231,0.0531,0.122,0.282,0.651,1.5],"index_2":[0.0005,0.00102,0.0021,0.00429,0.00878,0.018,0.0368]}
