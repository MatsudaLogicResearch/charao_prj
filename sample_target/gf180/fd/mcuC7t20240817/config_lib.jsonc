//--- simulator settings
  ,"simulator"  : "ngspice"
  ,"runsim"     : "true"
  ,"num_thread" : 4
//--- ISS-00230: 有効桁。 .lib / doc の出力桁に加え、 maxstep(=.tran の tmax) の有効桁にも使う。
//    ⚠ この値を変えると sim の刻みも変わる＝結果が動く。 未指定ならモデル既定 3。
  ,"significant_digits" : 3
  ,"sim_nice"   : 19
//--- ISS-00234(2026-08-21、 ダーマツ判断): 20 -> 0.3 ns(300 ps)。 3 PDK を同じ値に揃えて
//    slew_min 10 ps 化の退行確認を行う。 ⚠ probe(ISS-00219) が trans_out から maxstep を
//    決めるため、 この上限には届かない点が多い（Run ③ で実測 10〜17 ps）。
  ,"tmax_high"              : 0.3
// ISS-00219/00223: 出力遷移 trans_out に対し 4 点以上を目安に決める（trans_out / tmax_low）。
//   sky130 は遷移 17〜25ps で 0.02 だと約 1 点＝不足のため 0.002。gf180 は 70〜96ps で 0.02（約 4 点）で十分。
  ,"tmax_low"               : 0.02
// ISS-00219: const / delay / mpw で出力遷移 trans_out に何点のサンプルを乗せるか（点数）。
//   maxstep = min(maxstep, trans_out / この値)。 掃引位置を固定したまま反復収束させる。
//   0.0 で無効＝従来動作。 2.0 は実測（sky130 dfxtp_1 setup 最悪点で差 5.0064 → 0.0474 ns）。
  ,"simulation_points_per_transition" : 2.0
//--- ISS-00234(2026-08-21、 ダーマツ判断): simulation_slew_min を 0.001 -> 0.01 ns(10 ps) へ。
//    PWL の遷移幅の下限。 1 ps のエッジは ngspice の LTE が刻みを詰める要因になりうるため
//    10 ps へ引き上げる。 3 PDK すべて同じ値に揃える（係数の書き換えが PDK 非依存のため、
//    片方だけ変えると leak の AVG 窓 [11*..1*] や tslew_clk が 1/10 に潰れる）。
//    ⚠ この値が効く先（実効値は括弧内）:
//      init パルスのエッジ  INIT_EDGE_MULT(2) * slew_min      (20 ps)
//      t_rel3 / t_clk7 の終端エッジ、 VPC_CTRL の両エッジ        (10 ps)
//      tslew_in / tslew_clk / tslew_rel の既定                  (10 ps)
//      未使用 phase の折れ点間隔（ISS-00134）                    (10 ps)
//      leak の AVG 窓 {_t_in0-11*slew_min .. _t_in0-1*slew_min} (幅 100 ps、 従来と同じ)
//      .MEASURE の TD マージン 1*slew_min                       (10 ps)
  ,"simulation_slew_min"        : 0.01
//--- ISS-00234(2026-08-22、 ダーマツ判断): pre-charge SW（ISS-00076）のゲートランプ幅[ns]。
//    simulation_slew_min から切り離した専用値（既定 1 ps）。
//    A4 は DUT の入力波形ではなく **アナログ SW のゲート制御**で、 SW_PRECHARGE は
//    Ron=0.1Ω → Roff=1GΩ の 10 桁をヒステリシス(Vh=0.3)付きで通過する。
//    slew_min を 1 ps -> 10 ps にしたところ、 このランプの途中で LTE が破綻し
//    sky130 dfrtp_1 に 16 件の `Timestep too small` が出た（run_tm03_sky、 t=3.00667 ns）。
  ,"sw_ramp_time"               : 0.001
  // ISS-00160: min_pulse のパルス slew は templates の kind=mpw（index_1）で指定するため simulation_slew_for_pulse は廃止（2026-07-17）
  ,"sim_pulse_max"              : 5.0
  ,"sim_prop_max"               : 25.0
  ,"sim_prop_tri_max"           : 25.0
  ,"sim_prop_io_max"            : 30.0
  ,"sim_prop_io_tri_max"        : 30.0
  ,"sim_d2c_max"                : 6.0
	,"sim_c2d_min"                : 10.0
	,"sim_c2d_max"                : 200.0
  ,"sim_c2d_max_per_unit"       : 50.0
  ,"sim_segment_timestep_start" : 1.0
  ,"sim_segment_timestep_ratio" : 0.1
  ,"sim_segment_timestep_min"   : 0.001
  ,"sim_time_const_threshold"   : 0.1
// ISS-00218(B): const 掃引の終了判定に使う劣化量の閾値を、基準遅延 d0 に比例させる係数。
//   閾値 = min(sim_time_const_threshold, d0 × 本係数)。 d0 は judge_dly の running-min。
//   0.0（既定・未指定）で比例項を無効＝従来どおり sim_time_const_threshold の絶対値のみ。
  ,"sim_time_const_threshold_ratio" : 0.03
// ISS-00218(B): min_pulse_width 掃引の劣化判定に使う閾値 [ns]。
//   const（setup/hold/recovery）とは判定量が違うため別キーにした。
//   値は従来 const と共用していたときと同じ（挙動不変）。
  ,"sim_time_pulse_threshold"       : 0.1
// ISS-00220: const 掃引の高速化。 0 回目（準備 run）で _t_init3 時点の内部ノード電圧を取得し、
//   1 回目以降は nodeset で復元して測定区間だけ回す（初期化のやり直しを止める）。
//   false で従来動作（0 から回し直す）。 値の切り分け用に残してある。
  ,"const_start_offset_enable"       : true
  ,"sim_tsim_end4hold"          : 35.0
  ,"sim_pullres_std_enable"     : 100000
  ,"sim_pullres_std_disable"    : 100000

  ,"compress_result"      : "False"
  ,"supress_msg"          : "false"
  ,"supress_sim_msg"      : "false"
  ,"supress_debug_msg"    : "true"

}
