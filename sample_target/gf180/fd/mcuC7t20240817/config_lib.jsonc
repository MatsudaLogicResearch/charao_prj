// GF180MCU PDK (gf180) - fd standard cell library
// Revision: mcuC7t20240817 (7-track, volare 0fe599b2afb6708d281543108caf8310912f54af)
//
// Templates: TT/25C/5V values from open_pdks .lib
//   index_1 (10pt): common to all templates
//   index_2 (10pt): 39 groups (5% tolerance) for delay/power
//
// Future work: per-corner index_1 optimization
//===================================================================
// [Info] The order of "ports_dict" is same as the order of pin-list in the spice file.
{
   "process_name"       : "gf180"
  ,"lib_vendor_id"      : "fd"
  ,"revision"           : "mcuC7t20240817"
  ,"model_path"         : "./sample_target/gf180"
//--- ISS-00184: model file の .lib section 名（既定）。 charao は
//    .lib '<model file>' <section> で読む。 セル個別に変えたい場合は
//    cell_info 側の "model_section" が優先される（例 decap: ["mos","rc"]）。
  ,"model_section"      : ["mos"]
  ,"result_path"        : "./rslt"
  ,"vdd_name"           : "VDD"
  ,"vss_name"           : "VSS"
  ,"pwell_name"         : "VPW"
  ,"nwell_name"         : "VNW"
  ,"voltage_unit"       : "V"
  ,"capacitance_unit"   : "pf"
  ,"resistance_unit"    : "Ohm"
  ,"current_unit"       : "mA"
  ,"leakage_power_unit" : "uW"
  ,"energy_unit"        : "pJ"
  ,"time_unit"          : "ns"

//--- characterization conditions
// "cell_group"                  : "std"     //--- set by argv of charao.py
// "process_corner"              : "TT"      //--- set by argv of charao.py
//,"temperature"                 : 25.0      //--- set by argv of charao.py
//,"vdd_voltage"                 : 5.0       //--- set by argv of charao.py
//,"vss_voltage"                 : 0.0       //--- set by argv of charao.py
//,"pwell_voltage"               : 0.0       //--- set by argv of charao.py
//,"nwell_voltage"               : 5.0       //--- set by argv of charao.py
  ,"spiceinit"                   : ["set ngbehavior=hsp"]
  ,"logic_threshold_high"        : 0.7
  ,"logic_threshold_low"         : 0.3
  ,"logic_high_to_low_threshold" : 0.5
  ,"logic_low_to_high_threshold" : 0.5
// ISS-00218(A): const 判定量 judge_dly の TRIG 側閾値（入力信号＝制約ピン / CLK 側）。
//   遷移の「開始側」に置く（rise=0.1 / fall=0.9）。 TARG（出力）は 50% のまま。
//   .lib に出る値・ヘッダ宣言（input/output_threshold_pct 等）には一切影響しない。
//   50% 基準だと nominal に「入力が 50% から実効的な確定点まで進む時間」が混入し、
//   slew が緩いほど判定量が小さく評価されて、 絶対値の sim_time_const_threshold が
//   corner ごとに違う厳しさになってしまう。
  ,"const_judge_threshold_rise"  : 0.1
  ,"const_judge_threshold_fall"  : 0.9
  ,"slew_derate_from_library"    : 0.5
// ISS-00165: leakage の嵩上げ値＝全セルに一律加算する定数（単位＝leakage_power_unit＝uW）。
//   orig(gf180) は sim で再現できない一律成分を全セルに持つ。 実測（2026-07-24）で
//   orig - charao(計測値) が inv_1〜inv_20（駆動 1x〜20x）の全域で 4.90〜5.00e-05 の
//   ほぼ一定値と判明（比は 2.96→1.10 と変動）＝clamp ではなく加算が正しい。
//   sim で取得できない根拠：i_vnw は 1e-20 の数値ノイズ（well 接合が未モデル化）、
//   fill は空 subckt（Tr ゼロ）で全端子電流 0 なのに orig は 5e-05、 かつ area 64 倍でも値が不変。
//   物理セル(fill/fillcap/endcap/filltie)は measure ゼロのため、 この値がそのまま出力される。
  ,"leakage_offset"              : 5e-05
// ISS-00166/00167: leakage op の状態確立 tran(tslew_in)の絶対時間（ns）。 内部保持/競合ノード
//   （例 latch の nMOS パス劣化 H≈VDD-Vth）が静定してから nodeset 値を捕捉するため 10ns（latch 系で静定確認）。
  ,"leakage_stable_time" : 1
  ,"energy_meas_low_threshold"   : 0.01
  ,"energy_meas_high_threshold"  : 0.99
  ,"hold_meas_high_threshold"    : 0.01
  ,"hold_meas_low_threshold"     : 0.99

