*title: delay meas.
.option brief nopage nomod post=1 ingold=2
{%- if param.meas_energy not in [2,3,4,5] %}
.option autostop
{%- endif %}
*.option abstol=1e-11
*.option gmin=1e-10
*.option rshunt=1e9
.options NOREFVALUE
* ISS-00077: reltol=1e-4 で adaptive step を tight に → 入力 slew 大 × load 大での出力急変解像度向上（setup_rising avg +2.5ns → +0.16ns）
.option reltol=1e-4

.inc '{{param.model}}'
.inc '{{param.netlist}}'

.temp {{param.temp}}

.param _vdd = {{param.voltage_vsnp[0]}}
.param _vss = {{param.voltage_vsnp[1]}}
.param _vnw = {{param.voltage_vsnp[2]}}
.param _vpw = {{param.voltage_vsnp[3]}}

{%if param.voltage_vsnp | length >=6 %}
.param _vddio = {{param.voltage_vsnp[4]}}
.param _vssio = {{param.voltage_vsnp[5]}}
{%else %}
.param _vddio = {_vdd}
.param _vssio = {_vss}
{%endif %}

{%if param.vdd_vss_for_oirc  is defined %}
.param _vdd_vout = {{param.vdd_vss_for_vin_vrel[0]}}
.param _vss_vout = {{param.vdd_vss_for_vin_vrel[1]}}
.param _vdd_vin  = {{param.vdd_vss_for_vin_vrel[2]}}
.param _vss_vin  = {{param.vdd_vss_for_vin_vrel[3]}}
.param _vdd_vrel = {{param.vdd_vss_for_vin_vrel[4]}}
.param _vss_vrel = {{param.vdd_vss_for_vin_vrel[5]}}
.param _vdd_vclk = {{param.vdd_vss_for_vin_vrel[6]}}
.param _vss_vclk = {{param.vdd_vss_for_vin_vrel[7]}}
{%else %}
.param _vdd_vout = {_vdd}
.param _vss_vout = {_vss}
.param _vdd_vin  = {_vdd}
.param _vss_vin  = {_vss}
.param _vdd_vrel = {_vdd}
.param _vss_vrel = {_vss}
.param _vdd_vclk = {_vdd}
.param _vss_vclk = {_vss}
{%endif %}

.param cap  = {{param.cap}}
.param pullres  = {{param.pullres}}

.param _tslew_min  = {{param.tslew_min}}
.param _timestep   = {{param.timestep}}
.param _tmax       = {{param.timestep_tmax}}
.param _tsim_end   = {{param.tsim_end}}

** timing (ISS-00080: Python 側 Mtp.compute_timing() で算出した絶対時刻を直接埋め込み。
**          jp2 側 `.param` 計算撤廃、 Python 側で単一管理。 clk_role 分岐も Python 側で完結。
**          spice 内で参照される _t_* のみ残し、 中間 .param (_tdelay_init 等、 _t_init1/2、 _t_rel2/3) は削除。)
.param _t_init0 = {{param.t_init0}}
.param _t_init3 = {{param.t_init3}}

.param _t_in0   = {{param.t_in0}}
.param _t_in1   = {{param.t_in1}}

.param _t_rel0  = {{param.t_rel0}}
.param _t_rel1  = {{param.t_rel1}}
.param _t_rel2  = {{param.t_rel2}}
.param _t_rel3  = {{param.t_rel3}}

.param _t_clk0  = {{param.t_clk0}}
.param _t_clk1  = {{param.t_clk1}}
.param _t_clk2  = {{param.t_clk2}}
.param _t_clk3  = {{param.t_clk3}}
.param _t_clk4  = {{param.t_clk4}}
.param _t_clk5  = {{param.t_clk5}}
.param _t_clk6  = {{param.t_clk6}}
.param _t_clk7  = {{param.t_clk7}}


** DC
VDD_DYN VDD_DYN 0 DC {_vdd}
VSS_DYN VSS_DYN 0 DC {_vss}
VNW_DYN VNW_DYN 0 DC {_vnw}
VPW_DYN VPW_DYN 0 DC {_vpw}
VDDIO_DYN VDDIO_DYN 0 DC {_vddio}
VSSIO_DYN VSSIO_DYN 0 DC {_vssio}

*VHIGH VHIGH 0 DC {_vdd}
*VLOW  VLOW  0 DC {_vss}
*VHIGH_IO VHIGH_IO 0 DC {_vddio}
*VLOW_IO  VLOW_IO  0 DC {_vssio}

VHIGH VHIGH 0 PWL ({_tslew_min} {_vdd})
VLOW  VLOW  0 PWL (0           {_vss})
VHIGH_IO VHIGH_IO 0 PWL ({_tslew_min} {_vddio})
VLOW_IO  VLOW_IO  0 PWL (0           {_vssio})


** output load 
VOCAP VOUT WOUT DC 0

** tran
*.tran {_timestep} {_tsim_end} UIC maxstep=1e-10
*.tran {_timestep} {_tsim_end} 0 1e-11
.tran {_timestep} {_tsim_end} 0 {_tmax}


** DRIVE

**** VOUT
{% if param.val0_oirc[0] == "u" %}
 .IC V(WOUT)={_vdd_vout}
{% elif param.val0_oirc[0] == "d" %}
 .IC V(WOUT)={_vss_vout}
{% endif %}

**** WOUT pre-charge SW (ISS-00076: SW ON during _t_init0 ~ _t_init3-tslew_min)
**** ISS-00087: tdelay_in を 1 ns に短縮（pre-force あれば D→Q 待ち padding 不要）するため、 release を _t_init3 に変更。 release から D edge (_t_in0) まで tdelay_in=1 ns の安定期間で Q の internal settle を確保
{% if param.val0_oirc[0] in ["u","1"] %}
.model SW_PRECHARGE SW(Ron=0.1 Roff=1G Vt={{param.prop_vth_oirc[0]}} Vh=0.3)
VFORCE_VAL VFORCE_VAL 0 DC {_vdd_vout}
VPC_CTRL   VPC_CTRL   0 PWL(0 {_vss_vout} {_t_init0 - _tslew_min} {_vss_vout} {_t_init0} {_vdd_vout} {_t_init3 - _tslew_min} {_vdd_vout} {_t_init3} {_vss_vout})
SPRECHARGE WOUT VFORCE_VAL VPC_CTRL 0 SW_PRECHARGE
.IC V(WOUT)={_vdd_vout}
{% elif param.val0_oirc[0] in ["d","0"] %}
.model SW_PRECHARGE SW(Ron=0.1 Roff=1G Vt={{param.prop_vth_oirc[0]}} Vh=0.3)
VFORCE_VAL VFORCE_VAL 0 DC {_vss_vout}
VPC_CTRL   VPC_CTRL   0 PWL(0 {_vss_vout} {_t_init0 - _tslew_min} {_vss_vout} {_t_init0} {_vdd_vout} {_t_init3 - _tslew_min} {_vdd_vout} {_t_init3} {_vss_vout})
SPRECHARGE WOUT VFORCE_VAL VPC_CTRL 0 SW_PRECHARGE
.IC V(WOUT)={_vss_vout}
{% endif %}


**** VIN
{% if   param.arc_oirc[1] == "rise" %}
VIN VIN 0 PWL({_tslew_min} {_vss_vin} {_t_in0} {_vss_vin} {_t_in1} {_vdd_vin} )
{% elif param.arc_oirc[1] == "fall" %}
VIN VIN 0 PWL({_tslew_min}  {_vdd_vin} {_t_in0} {_vdd_vin} {_t_in1} {_vss_vin} )
{% elif param.val0_oirc[1] == "1" %}
*VIN VIN 0 DC {_vdd_vin}
VIN VIN 0 PWL({_tslew_min}  {_vdd_vin})
{% elif param.val0_oirc[1] == "0" %}
*VIN VIN 0 DC {_vss_vin}
VIN VIN 0 PWL({_tslew_min}  {_vss_vin})
{% elif param.val0_oirc[1] == "u" %}
.IC V(VIN)={_vdd_vin}
{% elif param.val0_oirc[1] == "d" %}
.IC V(VIN)={_vss_vin}
{% else %}
*.IC V(VIN)={_vss_vin}
VIN VIN 0 DC {_vss_vin}
{% endif %}

*** VREL (ISS-00085: pulse 機構追加 VCLK と対称、 _t_rel2/3 で ival に戻す round trip)
{% if   param.arc_oirc[2] == "rise" %}
VREL VREL 0 PWL({_tslew_min}  {_vss_vrel} {_t_rel0} {_vss_vrel} {_t_rel1} {_vdd_vrel} {_t_rel2} {_vdd_vrel} {_t_rel3} {_vss_vrel})
{% elif param.arc_oirc[2] == "fall" %}
VREL VREL 0 PWL({_tslew_min}  {_vdd_vrel} {_t_rel0} {_vdd_vrel} {_t_rel1} {_vss_vrel} {_t_rel2} {_vss_vrel} {_t_rel3} {_vdd_vrel})
{% elif param.val0_oirc[2] == "1" %}
*VREL VREL 0 DC {_vdd_vrel}
VREL VREL 0 PWL({_tslew_min}  {_vdd_vrel} )
{% elif param.val0_oirc[2] == "0" %}
*VREL VREL 0 DC {_vss_vrel}
VREL VREL 0 PWL({_tslew_min}  {_vss_vrel} )
{% elif param.val0_oirc[2] == "u" %}
.IC V(VREL) = {_vdd_vrel}
{% elif param.val0_oirc[2] == "d" %}
.IC V(VREL) = {_vss_vrel}
{% else %}
*.IC V(VREL) = {_vss_vrel}
VREL VREL 0 DC {_vss_vin}
{% endif %}

*** VCLK
{% if   param.val0_oirc[3] == "0" %}
VCLK VCLK 0 PWL({_tslew_min} {_vss_vclk} {_t_clk0} {_vss_vclk} {_t_clk1} {_vdd_vclk} {_t_clk2} {_vdd_vclk}
 {%- if (param.clk_role == "related") %}
+               {_t_clk3} {_vss_vclk} {_t_clk4} {_vss_vclk} {_t_clk5} {_vdd_vclk} {_t_clk6} {_vdd_vclk} {_t_clk7} {_vss_vclk})
 {%- elif (param.clk_role == "input") and (param.arc_oirc[3]=="rise") %}
+               {_t_clk3} {_vss_vclk} {_t_clk4} {_vss_vclk} {_t_clk5} {_vdd_vclk} {_t_clk6} {_vdd_vclk} {_t_clk7} {_vss_vclk})
 {%- elif (param.clk_role == "input") and (param.arc_oirc[3]=="fall") %}
+               {_t_clk3} {_vdd_vclk} {_t_clk4} {_vdd_vclk} {_t_clk5} {_vss_vclk} {_t_clk6} {_vss_vclk} {_t_clk7} {_vss_vclk})
 {%- else %}
+               )
 {%- endif %}

{% else %}
VCLK VCLK 0 PWL({_tslew_min} {_vdd_vclk} {_t_clk0} {_vdd_vclk} {_t_clk1} {_vss_vclk} {_t_clk2} {_vss_vclk}
 {%- if (param.clk_role == "related")  %}
+               {_t_clk3} {_vdd_vclk} {_t_clk4} {_vdd_vclk} {_t_clk5} {_vss_vclk} {_t_clk6} {_vss_vclk} {_t_clk7} {_vdd_vclk})
 {%- elif (param.clk_role == "input") and (param.arc_oirc[3]=="fall") %}
+               {_t_clk3} {_vdd_vclk} {_t_clk4} {_vdd_vclk} {_t_clk5} {_vss_vclk} {_t_clk6} {_vss_vclk} {_t_clk7} {_vdd_vclk})
 {%- elif (param.clk_role == "input") and (param.arc_oirc[3]=="rise") %}
+               {_t_clk3} {_vss_vclk} {_t_clk4} {_vss_vclk} {_t_clk5} {_vdd_vclk} {_t_clk6} {_vdd_vclk} {_t_clk7} {_vdd_vclk})
 {%- else %}
+               )
 {%- endif %}

{% endif %}


** MEASURE

{%- if   param.arc_oirc[0] in ["rise","fall"] %}
*** output change time
.MEASURE TRAN chg_out
+ WHEN v(VOUT)={{param.prop_vth_oirc[0]}} {{param.arc_oirc[0]}}=1 TD={_t_rel0 - 2*_tslew_min}
{%- endif %}

{%- if   (param.arc_oirc[0] in ["rise","fall"]) and (param.arc_oirc[2] in ["rise","fall"]) %}
*** Prop delay 
.MEASURE TRAN prop_in_out
+ TRIG v(VREL) VAL={{param.prop_vth_oirc[2]}} {{param.arc_oirc[2]}}=1 TD={_t_rel0 - 2*_tslew_min}
+ TARG v(VOUT) VAL={{param.prop_vth_oirc[0]}} {{param.arc_oirc[0]}}=1 TD={_t_rel0 - 2*_tslew_min}
{%- endif %}

{%- if  param.arc_oirc[0] in ["rise","fall"] %}
*** Trans delay 
.MEASURE TRAN trans_out
+ TRIG v(VOUT) VAL={{param.tran_v0_oirc[0]}} {{param.arc_oirc[0]}}=1 TD={_t_rel0 - 2*_tslew_min}
+ TARG v(VOUT) VAL={{param.tran_v1_oirc[0]}} {{param.arc_oirc[0]}}=1 TD={_t_rel0 - 2*_tslew_min}
{%- endif %}

{%-if (param.arc_oirc[1] in ["rise","fall"]) and (param.arc_oirc[2] in ["rise","fall"])%}
*** setup/recovery
.MEASURE TRAN setup_in_rel
+ TRIG v(VIN)  VAL={{param.prop_vth_oirc[1]}} {{param.arc_oirc[1]}}=1 TD={_t_clk3 - 2*_tslew_min}
+ TARG v(VREL) VAL={{param.prop_vth_oirc[2]}} {{param.arc_oirc[2]}}=1 TD={_t_clk3 - 2*_tslew_min}

*** hold/removal
.MEASURE TRAN hold_rel_in
+ TRIG v(VREL)  VAL={{param.prop_vth_oirc[2]}} {{param.arc_oirc[2]}}=1 TD={_t_clk3 - 2*_tslew_min}
+ TARG v(VIN)   VAL={{param.prop_vth_oirc[1]}} {{param.arc_oirc[1]}}=1 TD={_t_clk3 - 2*_tslew_min}
{%- endif %}

{%- if   param.meas_energy in [1,2] %}
*** energy time
.MEASURE TRAN energy_start
+ WHEN V(VREL)={{param.ener_v0_oirc[2]}} {{param.arc_oirc[2]}}=1 TD={_t_rel0 - 2*_tslew_min}

.MEASURE TRAN energy_end
+ WHEN V(VOUT)={{param.ener_v1_oirc[0]}} {{param.arc_oirc[0]}}=1 TD={_t_rel0 - 2*_tslew_min}
{%- endif %}

{%- if   param.meas_energy in [2,4,5] %}
*** In/Out Q, Capacitance 
.MEASURE TRAN q_rel_dyn INTEG I(VREL)  FROM={{param.time_energy[0]}} TO={{param.time_energy[1]}}
.MEASURE TRAN q_in_dyn  INTEG I(VIN)   FROM={{param.time_energy[0]}} TO={{param.time_energy[1]}}
.MEASURE TRAN q_clk_dyn INTEG I(VCLK)  FROM={{param.time_energy[0]}} TO={{param.time_energy[1]}}
.MEASURE TRAN q_out_dyn INTEG I(VOCAP) FROM={{param.time_energy[0]}} TO={{param.time_energy[1]}}

*** Energy (Total charge, Short-Circuit Charge)
.MEASURE TRAN q_vdd_dyn INTEG I(VDD_DYN)      FROM={{param.time_energy[0]}} TO={{param.time_energy[1]}}
.MEASURE TRAN q_vss_dyn INTEG I(VSS_DYN)      FROM={{param.time_energy[0]}} TO={{param.time_energy[1]}}
.MEASURE TRAN q_vddio_dyn INTEG I(VDDIO_DYN) FROM={{param.time_energy[0]}} TO={{param.time_energy[1]}}
.MEASURE TRAN q_vssio_dyn INTEG I(VSSIO_DYN) FROM={{param.time_energy[0]}} TO={{param.time_energy[1]}}

*** Leakage current
.MEASURE TRAN i_vdd_leak   AVG I(VDD_DYN)    FROM={_t_in0 - 101*_tslew_min} TO={_t_in0 - 1*_tslew_min}
.MEASURE TRAN i_vss_leak   AVG I(VSS_DYN)    FROM={_t_in0 - 101*_tslew_min} TO={_t_in0 - 1*_tslew_min}
.MEASURE TRAN i_vnw_leak   AVG I(VNW_DYN)    FROM={_t_in0 - 101*_tslew_min} TO={_t_in0 - 1*_tslew_min}
.MEASURE TRAN i_vpw_leak   AVG I(VPW_DYN)    FROM={_t_in0 - 101*_tslew_min} TO={_t_in0 - 1*_tslew_min}
.MEASURE TRAN i_vddio_leak AVG I(VDDIO_DYN) FROM={_t_in0 - 101*_tslew_min} TO={_t_in0 - 1*_tslew_min}
.MEASURE TRAN i_vssio_leak AVG I(VSSIO_DYN) FROM={_t_in0 - 101*_tslew_min} TO={_t_in0 - 1*_tslew_min}

* Gate leak current 
.MEASURE TRAN i_rel_leak AVG I(VREL) FROM={_t_rel0} TO={_t_rel1}
.MEASURE TRAN i_in_leak  AVG I(VIN)  FROM={_t_in0}  TO={_t_in1}
.MEASURE TRAN i_clk_leak AVG I(VCLK) FROM={_t_rel0} TO={_t_rel1}

{%- elif   param.meas_energy == 3 %}
* Gate leak current
.MEASURE TRAN i_vdd_leak   AVG I(VDD_DYN)   FROM={{param.time_energy[0]}} TO={{param.time_energy[1]}}
.MEASURE TRAN i_vss_leak   AVG I(VSS_DYN)   FROM={{param.time_energy[0]}} TO={{param.time_energy[1]}}
.MEASURE TRAN i_vnw_leak   AVG I(VNW_DYN)   FROM={{param.time_energy[0]}} TO={{param.time_energy[1]}}
.MEASURE TRAN i_vpw_leak   AVG I(VPW_DYN)   FROM={{param.time_energy[0]}} TO={{param.time_energy[1]}}
.MEASURE TRAN i_vddio_leak AVG I(VDDIO_DYN) FROM={{param.time_energy[0]}} TO={{param.time_energy[1]}}
.MEASURE TRAN i_rel_leak   AVG I(VREL)      FROM={{param.time_energy[0]}} TO={{param.time_energy[1]}}

{%- endif %}


{%- if   param.meas_o_max_min ==  1 %}
*** output min/max
.MEASURE TRAN o_max_v MAX V(VOUT) FROM={_t_rel0} TO={_t_rel1+10e-9}
.MEASURE TRAN o_min_v MIN V(VOUT) FROM={_t_rel0} TO={_t_rel1+10e-9}
{%- endif %}


**** CONTROL
***comment out .control for ngspice batch mode 
**.control 
** step param _tsweep_rel list {{ tsweep_rel | join(" ") }}
** op
** *plot V(VIN) V(VOUT) 
**.endc 

** INSTANCE
XCELL VCLK VREL VIN VOUT VHIGH VLOW VHIGH_IO VLOW_IO VDD_DYN VSS_DYN VNW_DYN VPW_DYN VDDIO_DYN VSSIO_DYN DUT
C0 WOUT 0 'cap'

**** for three state
{% if param.pullres_role != "nouse" %}
 VDD_PULL_DYN VDD_PULL_DYN 0 DC {_vdd_vout}
 VSS_PULL_DYN VSS_PULL_DYN 0 DC {_vss_vout}
 .model SW_NMOS SW(Ron=1G         Roff={pullres} Vt={{param.prop_vth_oirc[0]}} Vh=0.3)
 .model SW_PMOS SW(Ron=1{pullres} Roff=1G        Vt={{param.prop_vth_oirc[0]}} Vh=0.3)
{% endif %}

**** for three state enable
{% if param.pullres_role == "up" %}
 R0 WOUT VDD_PULL_DYN 'pullres'
 .IC V(WOUT)={_vdd_vout}
{% elif param.pullres_role == "down" %}
 R0 WOUT VSS_PULL_DYN 'pullres'
 .IC V(WOUT)={_vss_vout}
{% endif %}

**** for three state disable
{% if   param.pullres_role == "up_ngate" %}
 S1 WOUT VDD_PULL_DYN {{param.pullres_gate}} 0 SW_NMOS
{% elif param.pullres_role == "up_pgate" %}
 S1 WOUT VDD_PULL_DYN {{param.pullres_gate}} 0 SW_PMOS
{% elif param.pullres_role == "down_ngate" %}
 S1 WOUT VSS_PULL_DYN {{param.pullres_gate}} 0 SW_NMOS
{% elif param.pullres_role == "down_pgate" %}
 S1 WOUT VSS_PULL_DYN {{param.pullres_gate}} 0 SW_PMOS
{% endif %}


.SUBCKT DUT CLK REL IN OUT HIGH LOW HIGH_IO LOW_IO VDD VSS VNW VPW VDDIO VSSIO
{{param.tb_instance}}

.ends

{%- if param.wave_raw %}
* ISS-00078: write waveform raw via ngspice control block
.control
run
write sim.sp.raw {{ param.wave_save_list }}
.endc
{%- endif %}

.end

